<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FontManager: original XML text size, so the size multiplier never compounds -->
    <item name="tag_base_text_size" type="id" />
    <!-- FontManager: original XML text style (bold or not), so the bold toggle can be undone -->
    <item name="tag_base_text_style" type="id" />
    <!-- MinimalDialog: text size in sp before the font size setting, so an open dialog can be resized -->
    <item name="tag_dialog_sp" type="id" />
    <!-- LauncherActivity: where a music bar touch started, to drop the press highlight on a swipe -->
    <item name="tag_touch_x" type="id" />
</resources>
