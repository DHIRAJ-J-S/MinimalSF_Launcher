<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fitsSystemWindows="true">

<LinearLayout
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← back"
            android:textColor="@color/grey_dim"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ripple_borderless"
            android:paddingVertical="8dp"
            android:paddingEnd="16dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="settings"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" />

    <!-- Set as default -->
    <LinearLayout
        android:id="@+id/setDefaultBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/ripple_item">
        <TextView android:id="@+id/setDefaultLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="set as default launcher" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/setDefaultArrow" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="→" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Music toggle -->
    <LinearLayout
        android:id="@+id/musicToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="show now playing bar" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/musicToggleState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="[off]" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:id="@+id/musicDivider" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Auto launch delay -->
    <LinearLayout
        android:id="@+id/delayBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="auto-launch delay" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/delayValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="[200ms]" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Clock format -->
    <LinearLayout
        android:id="@+id/clockToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="clock format" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/clockToggleState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="[12h]" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Screen time -->
    <LinearLayout android:id="@+id/screenTimeToggle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="20dp" android:paddingVertical="18dp"
        android:clickable="true" android:focusable="true" android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="show screen time" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/screenTimeState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="[off]" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Search bar position -->
    <LinearLayout
        android:id="@+id/searchPosToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="18dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="search bar position" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/searchPosState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="[top]" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Search mode -->
    <LinearLayout android:id="@+id/searchModeToggle"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="20dp" android:paddingVertical="18dp"
        android:clickable="true" android:focusable="true" android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="search matching" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/searchModeState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="[starts with]" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Font style -->
    <LinearLayout android:id="@+id/fontStyleBtn"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="20dp" android:paddingVertical="18dp"
        android:clickable="true" android:focusable="true" android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="font" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/fontStyleState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="[mono]" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Font size -->
    <LinearLayout android:id="@+id/fontSizeBtn"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="20dp" android:paddingVertical="18dp"
        android:clickable="true" android:focusable="true" android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="font size" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/fontSizeState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="[default]" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Clock size -->
    <LinearLayout android:id="@+id/clockSizeBtn"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="20dp" android:paddingVertical="18dp"
        android:clickable="true" android:focusable="true" android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="clock size" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/clockSizeState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="[default]" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Gestures (own screen) -->
    <LinearLayout android:id="@+id/gesturesBtn"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="20dp" android:paddingVertical="18dp"
        android:clickable="true" android:focusable="true" android:background="@drawable/ripple_item">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="gestures" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" />
        <TextView android:id="@+id/gesturesState" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="→" android:textColor="@color/grey_text" android:textSize="12sp" android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" android:layout_marginHorizontal="20dp" />

    <!-- Credits -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="50dp"
        android:text="By THE.404GUY ;)"
        android:textColor="@color/grey_dim"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.06" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:text="100% Open Source"
        android:textColor="@color/grey_mid"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.04" />

    <!-- Opens the repo in the browser (the app itself has no internet permission) -->
    <ImageView
        android:id="@+id/githubBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:padding="11dp"
        android:src="@drawable/ic_github"
        app:tint="@color/grey_dim"
        android:background="@drawable/ripple_borderless"
        android:contentDescription="source code on github"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="30dp"
        android:id="@+id/versionText"
        android:text="MinimalSF"
        android:textColor="#FF444444"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:letterSpacing="0.04" />

</LinearLayout>
</ScrollView>
