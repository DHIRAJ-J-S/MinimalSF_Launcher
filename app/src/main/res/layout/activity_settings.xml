<?xml version="1.0" encoding="utf-8"?>
<!-- Used for the main settings menu and each of its pages; SettingsActivity adds the rows. -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

<LinearLayout
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← back"
            android:textColor="@color/grey_dim"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/ripple_borderless"
            android:paddingVertical="8dp"
            android:paddingEnd="16dp" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="settings"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" />

    <LinearLayout
        android:id="@+id/settingsRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- Takes the free space, so the credits sit at the bottom of the screen (and scroll if it's short) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Credits, on the main menu only -->
    <LinearLayout
        android:id="@+id/creditsGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="24dp"
            android:text="By THE.404GUY ;)"
            android:textColor="@color/grey_dim"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="100% Open Source"
            android:textColor="@color/grey_mid"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.04" />

        <!-- Opens the repo in the browser (the app itself has no internet permission) -->
        <ImageView
            android:id="@+id/githubBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:padding="11dp"
            android:src="@drawable/ic_github"
            app:tint="@color/grey_dim"
            android:background="@drawable/ripple_borderless"
            android:contentDescription="source code on github"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="30dp"
            android:text="MinimalSF"
            android:textColor="#FF444444"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.04" />
    </LinearLayout>

</LinearLayout>
</ScrollView>
