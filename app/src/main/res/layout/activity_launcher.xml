<?xml version="1.0" encoding="utf-8"?>
<!-- System bar + keyboard insets are applied in code (LauncherActivity.setupInsets) so the
     layout follows the keyboard animation instead of jumping. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Clock + RAM -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <!-- Clock sits below the RAM line so a wide "12:59 PM" can't run into it -->
        <TextView android:id="@+id/clockText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="32dp" android:paddingHorizontal="16dp"
            android:gravity="center" android:textColor="@android:color/white" android:textSize="52sp"
            android:fontFamily="monospace" android:textStyle="bold" android:letterSpacing="-0.04"
            android:background="@drawable/ripple_borderless"
            android:clickable="true" android:focusable="true" android:text="00:00" />
        <TextView android:id="@+id/ramText" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="end|top" android:paddingEnd="16dp" android:paddingTop="8dp"
            android:textColor="#FF555555" android:textSize="11sp" android:fontFamily="monospace" android:text="ram ---mb" />
    </FrameLayout>

    <TextView android:id="@+id/dateText" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingTop="2dp" android:paddingBottom="20dp"
        android:textColor="@color/grey_dim" android:textSize="12sp" android:fontFamily="monospace"
        android:letterSpacing="0.08" android:textAllCaps="true" android:text="monday, jan 1" />

    <!-- Screen time (optional). Sits between date and search; the date's bottom padding moves here when shown. -->
    <TextView android:id="@+id/screenTimeText" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="-14dp" android:layout_marginBottom="14dp"
        android:paddingHorizontal="12dp" android:paddingVertical="4dp"
        android:textColor="@color/grey_mid" android:textSize="11sp" android:fontFamily="monospace" android:letterSpacing="0.04"
        android:background="@drawable/ripple_borderless" android:clickable="true" android:focusable="true"
        android:visibility="gone" />

    <!-- Search TOP slot -->
    <FrameLayout android:id="@+id/searchTopSlot"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp">
        <EditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="46dp"
            android:background="@drawable/search_bg" android:hint="@string/search_hint" android:textColorHint="@color/grey_mid"
            android:textColor="@android:color/white" android:textSize="16sp" android:fontFamily="monospace"
            android:inputType="text|textNoSuggestions" android:imeOptions="actionGo|flagNoExtractUi|flagNoPersonalizedLearning"
            android:importantForAutofill="no" android:singleLine="true"
            android:paddingStart="16dp" android:paddingEnd="40dp" android:textCursorDrawable="@drawable/cursor" />
        <ImageView android:id="@+id/clearBtn" android:layout_width="44dp" android:layout_height="46dp"
            android:layout_gravity="end|center_vertical" android:padding="13dp"
            android:src="@drawable/ic_close" app:tint="@color/grey_dim" android:visibility="gone"
            android:background="@drawable/ripple_borderless" android:contentDescription="clear"
            android:clickable="true" android:focusable="true" />
    </FrameLayout>

    <!-- Results -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/appList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingHorizontal="20dp" android:paddingTop="4dp" android:clipToPadding="false" android:scrollbars="none"
        android:overScrollMode="never" />

    <!-- Home tip (shown on first use, inside the black space). Text is set in code. -->
    <TextView android:id="@+id/homeTipView"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingVertical="20dp"
        android:textColor="#FF444444" android:textSize="12sp"
        android:fontFamily="monospace" android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

    <TextView android:id="@+id/noMatch" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:text="@string/no_match"
        android:textColor="@color/grey_mid" android:textSize="13sp" android:fontFamily="monospace" android:visibility="gone" />

    <!-- Auto launch -->
    <LinearLayout android:id="@+id/autoLaunchBar" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <ImageView android:id="@+id/autoLaunchIcon" android:layout_width="52dp" android:layout_height="52dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <TextView android:id="@+id/autoLaunchName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:textColor="@android:color/white" android:textSize="15sp" android:fontFamily="monospace" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="6dp"
            android:text="auto-launching…" android:textColor="@color/grey_mid" android:textSize="11sp"
            android:fontFamily="monospace" android:letterSpacing="0.06" />
    </LinearLayout>

    <!-- Search BOTTOM slot -->
    <FrameLayout android:id="@+id/searchBottomSlot"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="20dp" android:paddingVertical="8dp" android:visibility="gone" />

    <!-- Music tip (shown on first play) -->
    <LinearLayout android:id="@+id/musicTipView"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="20dp" android:paddingVertical="6dp"
        android:background="@color/search_bg" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="«" android:textColor="#FF444444" android:textSize="12sp" android:fontFamily="monospace" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center" android:text="swipe to skip  ·  tap to play/pause  ·  hold to open"
            android:textColor="#FF444444" android:textSize="10sp" android:fontFamily="monospace" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="»" android:textColor="#FF444444" android:textSize="12sp" android:fontFamily="monospace" />
        <ImageView android:id="@+id/musicTipClose" android:layout_width="32dp" android:layout_height="32dp"
            android:padding="9dp" android:src="@drawable/ic_close" app:tint="#FF555555"
            android:background="@drawable/ripple_borderless" android:contentDescription="dismiss tip"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <!-- Music bar -->
    <LinearLayout android:id="@+id/musicBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp"
        android:paddingVertical="14dp" android:background="@color/search_bg" android:visibility="gone">
        <!-- Drawn icon, not a ▶/⏸ character: some OEM fonts (e.g. Samsung) force ⏸ to colour emoji -->
        <ImageView android:id="@+id/musicIcon" android:layout_width="18dp" android:layout_height="18dp"
            android:layout_marginEnd="14dp" android:src="@drawable/ic_music" app:tint="@color/grey_dim"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/musicTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/grey_text" android:textSize="14sp"
            android:fontFamily="monospace" android:singleLine="true" android:ellipsize="end" android:text="no music playing" />
    </LinearLayout>

    <!-- Todo (hidden while searching / in all apps, so results get the space) -->
    <View android:id="@+id/todoDivider" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/grey_border" />
    <LinearLayout android:id="@+id/todoSection" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@android:color/black">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="todo" android:textColor="@color/grey_mid" android:textSize="11sp"
                android:fontFamily="monospace" android:letterSpacing="0.06" />
            <TextView android:id="@+id/todoCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/grey_mid" android:textSize="11sp" android:fontFamily="monospace" />
        </LinearLayout>
        <com.minimal.launcher.MaxHeightRecyclerView android:id="@+id/todoList"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:maxHeight="140dp"
            android:paddingHorizontal="20dp" android:clipToPadding="false" android:scrollbars="none"
            android:overScrollMode="never" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="20dp" android:paddingEnd="12dp" android:paddingVertical="6dp">
            <EditText android:id="@+id/todoInput" android:layout_width="0dp" android:layout_height="36dp"
                android:layout_weight="1" android:background="@drawable/todo_input_bg" android:hint="add task…"
                android:textColorHint="@color/grey_mid" android:textColor="@android:color/white" android:textSize="12sp"
                android:fontFamily="monospace" android:inputType="text" android:imeOptions="actionDone|flagNoExtractUi"
                android:importantForAutofill="no" android:textCursorDrawable="@drawable/cursor"
                android:singleLine="true" android:paddingHorizontal="10dp" />
            <ImageView android:id="@+id/addTodoBtn" android:layout_width="40dp" android:layout_height="36dp"
                android:padding="9dp" android:src="@drawable/ic_add" app:tint="@color/grey_dim"
                android:background="@drawable/ripple_borderless" android:contentDescription="add task"
                android:clickable="true" android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom nav -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingHorizontal="8dp" android:paddingVertical="4dp"
        android:background="@android:color/black">
        <TextView android:id="@+id/allAppsBtn" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="all apps" android:textColor="@color/grey_text"
            android:textSize="13sp" android:fontFamily="monospace" android:letterSpacing="0.04"
            android:paddingVertical="12dp" android:paddingHorizontal="12dp"
            android:gravity="center_vertical" android:drawablePadding="10dp"
            android:background="@drawable/ripple_item"
            android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/settingsBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="settings" android:textColor="@color/grey_text" android:textSize="13sp"
            android:fontFamily="monospace" android:letterSpacing="0.04"
            android:paddingVertical="12dp" android:paddingHorizontal="12dp"
            android:gravity="center_vertical" android:drawablePadding="10dp"
            android:background="@drawable/ripple_item"
            android:clickable="true" android:focusable="true" />
    </LinearLayout>

</LinearLayout>
